{
    "manifest_version": 3,
    "name": "User Manage-inator",
    "version": "1.5",
    "description": "Auto-fill user management wizard for 1Look (1look.cloud) with smart role mapping.",
    "permissions": ["tabs", "activeTab", "scripting", "sidePanel", "storage", "contextMenus", "clipboardWrite"],
    "host_permissions": ["<all_urls>"],
    "side_panel": { "default_path": "sidepanel.html" },
    "background": { "service_worker": "background.js" },
    "action": { "default_title": "Open Auto-Fill Panel" },
    "content_scripts": [{
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "all_frames": true,
        "run_at": "document_end"
    }]
}
